  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./build/typecheck-tests.tsbuildinfo"
  },
  "include": ["tests/**/*", "vitest.config.ts"],
