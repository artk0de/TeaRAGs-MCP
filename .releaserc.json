{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "parserOpts": {
          "mergePattern": "^Merge"
        },
        "releaseRules": [
          { "breaking": true, "release": "minor" },

          {
            "type": "feat",
            "scope": "!{test,beads,scripts,ci,website,deps,onnx,embedding,embedded,adapters,qdrant,git,config,factory,bootstrap,debug,logs}",
            "release": "minor"
          },
          {
            "type": "feat",
            "scope": "{onnx,embedding,embedded,adapters,qdrant,git,config,factory,bootstrap,debug,logs}",
            "release": "patch"
          },
          {
            "type": "improve",
            "scope": "!{test,beads,scripts,ci,website,deps}",
            "release": "patch"
          },
          {
            "type": "fix",
            "scope": "!{test,beads,scripts,ci,website,deps}",
            "release": "patch"
          },
          {
            "type": "perf",
            "scope": "!{test,beads,website}",
            "release": "patch"
          },
          {
            "type": "refactor",
            "scope": "!{test,beads,scripts,ci,website}",
            "release": "patch"
          },
          { "type": "docs", "release": "patch" },

          {
            "type": "feat",
            "scope": "{test,beads,scripts,ci,website,deps}",
            "release": false
          },
          {
            "type": "improve",
            "scope": "{test,beads,scripts,ci,website,deps}",
            "release": false
          },
          {
            "type": "fix",
            "scope": "{test,beads,scripts,ci,website,deps}",
            "release": false
          },
          { "type": "perf", "scope": "{test,beads,website}", "release": false },
          {
            "type": "refactor",
            "scope": "{test,beads,scripts,ci,website}",
            "release": false
          },

          { "type": "style", "release": false },
          { "type": "test", "release": false },
          { "type": "chore", "release": false },
          { "type": "ci", "release": false },
          { "type": "build", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "parserOpts": {
          "mergePattern": "^Merge"
        },
        "presetConfig": {
          "types": [
            { "type": "feat", "scope": "plugin", "section": "Plugin" },
            { "type": "improve", "scope": "plugin", "section": "Plugin" },
            { "type": "fix", "scope": "plugin", "section": "Plugin" },
            { "type": "perf", "scope": "plugin", "section": "Plugin" },
            { "type": "docs", "scope": "plugin", "section": "Plugin" },
            { "type": "refactor", "scope": "plugin", "section": "Plugin" },
            { "type": "feat", "scope": "dinopowers", "section": "Plugin" },
            { "type": "improve", "scope": "dinopowers", "section": "Plugin" },
            { "type": "fix", "scope": "dinopowers", "section": "Plugin" },
            { "type": "perf", "scope": "dinopowers", "section": "Plugin" },
            { "type": "docs", "scope": "dinopowers", "section": "Plugin" },
            { "type": "refactor", "scope": "dinopowers", "section": "Plugin" },
            { "type": "feat", "scope": "skills", "section": "Plugin" },
            { "type": "improve", "scope": "skills", "section": "Plugin" },
            { "type": "fix", "scope": "skills", "section": "Plugin" },
            { "type": "perf", "scope": "skills", "section": "Plugin" },
            { "type": "docs", "scope": "skills", "section": "Plugin" },
            { "type": "refactor", "scope": "skills", "section": "Plugin" },
            { "type": "feat", "scope": "marketplace", "section": "Plugin" },
            { "type": "improve", "scope": "marketplace", "section": "Plugin" },
            { "type": "fix", "scope": "marketplace", "section": "Plugin" },
            { "type": "docs", "scope": "marketplace", "section": "Plugin" },
            { "type": "feat", "section": "Features" },
            { "type": "improve", "section": "Improvements" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance Improvements" },
            { "type": "docs", "section": "Documentation" },
            { "type": "refactor", "section": "Code Refactoring" },
            { "type": "style", "section": "Styles", "hidden": true },
            { "type": "test", "section": "Tests", "hidden": true },
            { "type": "chore", "section": "Chores", "hidden": true },
            { "type": "ci", "section": "CI/CD", "hidden": true },
            { "type": "build", "section": "Build System", "hidden": true }
          ],
          "commitGroupsSort": [
            "Breaking Changes",
            "Features",
            "Improvements",
            "Bug Fixes",
            "Performance Improvements",
            "Plugin",
            "Documentation",
            "Code Refactoring"
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/prepare-changelog.sh"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "pkgRoot": ".",
        "provenance": true
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "package-lock.json",
          "CHANGELOG.md",
          "website/docs/changelog.md"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "addReleases": "bottom"
      }
    ]
  ]
}
