  "files": {
    "README.md": "# widgets\n\nBilling, payments and ledger sync services.\n",
    "src/billing/TaxTable.ts": "export class TaxTable {\n  constructor(private readonly rates: Record<string, number>) {}\n\n  rateFor(region: string, sku?: string): number {\n    const key = sku ? `${region}:${sku}` : region;\n    return this.rates[key] ?? this.rates[region] ?? 0;\n  }\n}\n",
    "src/payments/Gateway.ts": "export class TimeoutError extends Error {}\n\nexport class Gateway {\n  constructor(private readonly endpoint: string) {}\n\n  async charge(payload: unknown): Promise<void> {\n    const res = await fetch(this.endpoint, { method: 'POST', body: JSON.stringify(payload) });\n    if (res.status === 504) {\n      throw new TimeoutError('gateway timeout');\n    }\n  }\n}\n",
    "src/util/format.ts": "export function formatCurrency(amount: number, currency: string): string {\n  if (currency === 'JPY') {\n    return `${Math.round(amount)} JPY`;\n  }\n  return `${amount.toFixed(2)} ${currency}`;\n}\n",
    "src/billing/InvoiceCalculator.ts": "import { TaxTable } from './TaxTable';\n\nexport interface InvoiceLine {\n  sku: string;\n  quantity: number;\n  unitPrice: number;\n  kind: 'charge' | 'credit';\n}\n\nexport class InvoiceCalculator {\n  constructor(private readonly taxes: TaxTable) {}\n\n  computeTotal(lines: InvoiceLine[], region: string): number {\n    let total = 0;\n    for (const line of lines) {\n      if (line.quantity === 0) {\n        continue;\n      }\n      const rate = this.taxes.rateFor(region, line.sku);\n      let amount = line.quantity * line.unitPrice;\n      if (line.kind === 'credit') {\n        amount = -amount;\n      } else if (amount < 0) {\n        throw new Error('negative charge');\n      }\n      // round per line, not per invoice\n      amount = Math.round(amount * (1 + rate) * 100) / 100;\n      total += amount;\n    }\n    return total;\n  }\n\n  applyDiscount(total: number, percent: number): number {\n    // discount is capped at 50 percent\n    return total - (total * Math.min(percent, 50)) / 100;\n  }\n}\n",
    "src/payments/RetryQueue.ts": "import { Gateway, TimeoutError } from './Gateway';\n\nexport interface RetryJob {\n  id: string;\n  attempts: number;\n  payload: unknown;\n}\n\nexport class RetryQueue {\n  private jobs: RetryJob[] = [];\n  private seen = new Set<string>();\n\n  constructor(private readonly gateway: Gateway, private readonly batchSize = 10) {}\n\n  enqueue(job: RetryJob): void {\n    if (this.seen.has(job.id)) {\n      return;\n    }\n    this.seen.add(job.id);\n    this.jobs.push(job);\n  }\n\n  async processBatch(): Promise<number> {\n    const batch = this.jobs.splice(0, this.batchSize);\n    let sent = 0;\n    for (const job of batch) {\n      try {\n        await this.gateway.charge(job.payload);\n        sent++;\n      } catch (error) {\n        if (error instanceof TimeoutError) {\n          this.seen.delete(job.id);\n        }\n        const delay = Math.min(2 ** job.attempts * 100, 60000);\n        job.attempts++;\n        setTimeout(() => this.enqueue(job), delay);\n      }\n    }\n    return sent;\n  }\n}\n",
    "src/sync/LedgerClient.ts": "export interface LedgerPage {\n  items: { status: string }[];\n  hasMore: boolean;\n}\n\nexport class LedgerClient {\n  async fetchPage(accountId: string, page: number): Promise<LedgerPage> {\n    const res = await fetch(`/ledger/${accountId}?page=${page}`);\n    return (await res.json()) as LedgerPage;\n  }\n}\n",
    "src/sync/LedgerSync.ts": "import { LedgerClient } from './LedgerClient';\n\nexport class LedgerSync {\n  constructor(private readonly client: LedgerClient) {}\n\n  async reconcile(accountId: string): Promise<number> {\n    let page = 0;\n    let matched = 0;\n    while (true) {\n      const entries = await this.client.fetchPage(accountId, page);\n      for (const entry of entries.items) {\n        if (entry.status === 'settled') matched++;\n      }\n      if (!entries.hasMore) break;\n      page++;\n    }\n    return matched;\n  }\n}\n",
    "tests/payments/RetryQueue.test.ts": "import { RetryQueue } from '../../src/payments/RetryQueue';\n\ndescribe('RetryQueue', () => {\n  it('processBatch sends queued jobs', async () => {\n    const gateway = { charge: async () => undefined } as any;\n    const queue = new RetryQueue(gateway);\n    queue.enqueue({ id: 'a', attempts: 0, payload: {} });\n    expect(await queue.processBatch()).toBe(1);\n  });\n});\n"
  },
