new file mode 100644
index 000000000..24c388940
--- /dev/null
+++ b/evals/swe-bench-lite/src/swe_lite_ab/localize.py
@@ -0,0 +1,313 @@
+"""Component localization benchmark: rank a repository's files for an issue text, no LLM anywhere.
+
+Each task's repository is indexed at its base commit. Every configuration ranks files for the ORIGINAL
+issue text (SWE-bench_Pro-locagent `problem_statement`, which names no paths, unlike Pro's
+instruction.md); the score is where the files of the gold patch land. tea-rags configurations differ
+only in tool (semantic vs hybrid) and rerank preset, so the table separates what semantic search,
+BM25 fusion and git-signal reranking each contribute. `bm25` is the lexical baseline, computed here.
+"""
+import json
+import math
+import re
+import subprocess
+import tempfile
+import time
+from collections import Counter
+from dataclasses import dataclass
+from pathlib import Path
+
+from . import config, indexing, repos
+from .tasks import gold_files
+
+LANGUAGE = "python"
+EXTS = (".py",)
+# Issue texts are a few KB; the cap only guards against a pathological one. Recorded per task.
+MAX_QUERY_CHARS = 6000
+TOP_PERSISTED = 50
+KS = (1, 5, 10)
+
+
+@dataclass(frozen=True)
+class LocalizeConfig:
+    name: str
+    tool: str
+    rerank: str | tuple[tuple[str, float], ...]  # preset name, or custom weights as (signal, weight) pairs
+    production: bool = False  # restrict the searched chunk set with the `production` filter preset
+
+
+TIEBREAK_WEIGHTS = (("similarity", 0.85), ("recency", 0.075), ("churn", 0.075))
+
+TEA_RAGS_CONFIGS = (
+    LocalizeConfig("semantic-relevance", "semantic_search", "relevance", False),
+    LocalizeConfig("hybrid-relevance", "hybrid_search", "relevance", False),
+    LocalizeConfig("hybrid-bugHunt", "hybrid_search", "bugHunt", False),
+    LocalizeConfig("hybrid-hotspots", "hybrid_search", "hotspots", False),
+    LocalizeConfig("semantic-relevance-prod", "semantic_search", "relevance", True),
+    LocalizeConfig("hybrid-relevance-prod", "hybrid_search", "relevance", True),
+    LocalizeConfig("hybrid-tiebreak-prod", "hybrid_search", TIEBREAK_WEIGHTS, True),
+    LocalizeConfig("semantic-tiebreak-prod", "semantic_search", TIEBREAK_WEIGHTS, True),
+)
+CONFIG_NAMES = tuple(c.name for c in TEA_RAGS_CONFIGS) + ("bm25", "bm25-prod")
+
+_NON_PRODUCTION_DIRS = {"tests", "test", "__tests__", "spec", "specs", "docs", "doc"}
+_TEST_FILE = re.compile(r"^test_.*\.py$|_test\.py$")
+
+
+def is_test_or_doc_path(path: str) -> bool:
+    """Same classifier as the SWE-bench Pro verifier: test/doc directories, conftest.py, test_*.py, *_test.py."""
+    *parents, base = path.split("/")
+    return bool(_NON_PRODUCTION_DIRS.intersection(parents)) or base == "conftest.py" or bool(_TEST_FILE.search(base))
+
+
+# --- pure core ---------------------------------------------------------------------------------
+
+_WORD = re.compile(r"[A-Za-z0-9]+")
+_CAMEL = re.compile(r"[A-Z]+(?=[A-Z][a-z])|[A-Z]?[a-z]+|[A-Z]+|[0-9]+")
+
+
+def tokenize(text: str) -> list[str]:
+    """Code-aware tokens: split on every non-alphanumeric (snake_case, dots, slashes) and on camelCase
+    boundaries, lowercased; tokens shorter than 2 characters are dropped."""
+    return [p.lower() for word in _WORD.findall(text) for p in _CAMEL.findall(word) if len(p) >= 2]
+
+
+def files_from_chunks(chunks: list[dict]) -> list[str]:
+    seen: dict[str, None] = {}
+    for c in chunks:
+        seen.setdefault(c["payload"]["relativePath"], None)
+    return list(seen)
+
+
+def bm25_scores(docs: dict[str, list[str]], query: list[str], k1: float = 1.2, b: float = 0.75) -> dict[str, float]:
+    n = len(docs)
+    if not n:
+        return {}
+    avgdl = sum(len(d) for d in docs.values()) / n or 1.0
+    terms = set(query)
+    df = Counter(t for d in docs.values() for t in terms.intersection(d))
+    idf = {t: math.log(1 + (n - df[t] + 0.5) / (df[t] + 0.5)) for t in terms if df[t]}
+    scores = {}
+    for path, tokens in docs.items():
+        tf = Counter(tokens)
+        dl = len(tokens)
+        s = sum(idf[t] * tf[t] * (k1 + 1) / (tf[t] + k1 * (1 - b + b * dl / avgdl)) for t in idf if tf[t])
+        if s > 0:
+            scores[path] = s
+    return scores
+
+
+def tracked_files(repo_dir: Path, exts: tuple[str, ...]) -> list[str]:
+    out = subprocess.run(["git", "ls-files", "-z"], cwd=repo_dir, check=True, capture_output=True, text=True).stdout
+    return [p for p in out.split("\0") if p.endswith(exts)]
+
+
+def bm25_rank(repo_dir: Path, query: str, exts: tuple[str, ...], exclude=None) -> list[str]:
+    """Files ranked by BM25 against the query; a document is the path's tokens plus the file's.
+    `exclude(path) -> bool` drops files from the corpus before scoring."""
+    docs = {}
+    for path in tracked_files(repo_dir, exts):
+        if exclude and exclude(path):
+            continue
+        try:
+            text = (Path(repo_dir) / path).read_text(errors="ignore")
+        except OSError:
+            continue
+        docs[path] = tokenize(path) + tokenize(text)
+    scores = bm25_scores(docs, tokenize(query))
+    return sorted(scores, key=lambda p: (-scores[p], p))
+
+
+def score(ranking: list[str], gold: list[str]) -> dict | None:
+    if not gold:
+        return None
+    gold_set = set(gold)
+    rank = next((i + 1 for i, f in enumerate(ranking) if f in gold_set), None)
+    m: dict = {"rank_of_first_gold": rank}
+    for k in KS:
+        found = len(gold_set.intersection(ranking[:k]))
+        m[f"recall@{k}"] = found / len(gold_set)
+        m[f"hit@{k}"] = int(found > 0)
+    m["mrr"] = 1 / rank if rank else 0.0
+    return m
+
+
+def scored_gold(patch: str) -> dict[str, list[str]]:
+    files = gold_files(patch)
+    return {"primary": [f for f in files if f.endswith(EXTS)], "secondary": files}
+
+
+def truncate_query(text: str, max_chars: int) -> tuple[str, bool]:
+    return (text, False) if len(text) <= max_chars else (text[:max_chars], True)
+
+
+def search_params(cfg: LocalizeConfig, alias: str, query: str, limit: int, offset: int,
+                  repo_dir: Path | None = None) -> dict:
+    # `filter: {}` clears the production filter bugHunt / hotspots would add; `production` configs ask
+    # for the preset explicitly, so the chunk-set restriction is always stated by the config itself.
+    rerank = cfg.rerank if isinstance(cfg.rerank, str) else {"custom": dict(cfg.rerank)}
+    return {"project": alias, "query": query, "limit": limit, "offset": offset, "language": LANGUAGE,
+            "filter": {"presets": "production"} if cfg.production else {},
+            "fields": ["relativePath"], "rerank": rerank,
+            **({"path": str(repo_dir)} if repo_dir is not None else {})}
+
+
+# --- thin I/O ----------------------------------------------------------------------------------
+
+def _env() -> dict:
+    import os
+
+    return {**os.environ, **config.EMBEDDING_ENV}
+
+
+def search_files(cfg: LocalizeConfig, alias: str, query: str, want: int = TOP_PERSISTED, page: int = 300,
+                 max_pages: int = 4, run=subprocess.run, repo_dir: Path | None = None) -> list[str]:
+    """Distinct files in rank order, paging chunks until `want` files or the tool runs dry. Raises
+    RuntimeError with the tool's error text. Runs outside any task repo: a repo-pinned node version
+    would break the CLI's node shim."""
+    chunks: list[dict] = []
+    for i in range(max_pages):
+        proc = run(["tea-rags", "call", cfg.tool, json.dumps(search_params(cfg, alias, query, page, i * page, repo_dir)), "--json"],
+                   env=_env(), capture_output=True, text=True, cwd=tempfile.gettempdir())
+        data = indexing._final_json(proc.stdout or "")
+        if proc.returncode != 0 or not data or data.get("isError"):
+            raise RuntimeError(f"{cfg.tool} exit {proc.returncode}: "
+                               f"{((proc.stderr or '') + (proc.stdout or ''))[-400:].strip()}")
+        results = (data.get("structuredContent") or {}).get("results", [])
+        if isinstance(results, dict):
+            # Current MCP answers fold two or more rows into a column table.
+            column = results["columns"].index("payload.relativePath")
+            results = [{"payload": {"relativePath": row[column]}} for row in results["rows"]]
+        chunks += results
+        if len(files_from_chunks(chunks)) >= want or len(results) < page:
+            break
+    return files_from_chunks(chunks)
+
+
+def _persist(instance_id: str, name: str, files: list[str], extra: dict) -> None:
+    out = config.RUNS / "localize" / instance_id / f"{name}.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps({"files": files[:TOP_PERSISTED], **extra}, indent=2) + "\n")
+
+
+def localize_task(instance_id: str, problem: str, patch: str, alias: str, repo_dir: Path,
+                  run=subprocess.run) -> dict:
+    query, truncated = truncate_query(problem, MAX_QUERY_CHARS)
+    gold = scored_gold(patch)
+    configs: dict[str, dict] = {}
+    rankers = [(c.name, lambda c=c: search_files(c, alias, query, run=run, repo_dir=repo_dir)) for c in TEA_RAGS_CONFIGS]
+    rankers.append(("bm25", lambda: bm25_rank(repo_dir, query, EXTS)))
+    rankers.append(("bm25-prod", lambda: bm25_rank(repo_dir, query, EXTS, exclude=is_test_or_doc_path)))
+    for name, rank in rankers:
+        started = time.monotonic()
+        try:
+            files, error = rank(), None
+        except (RuntimeError, OSError, subprocess.CalledProcessError) as e:
+            files, error = [], str(e)
+        seconds = round(time.monotonic() - started, 1)
+        _persist(instance_id, name, files, {"error": error, "seconds": seconds})
+        ok = error is None
+        configs[name] = {"error": error, "files": len(files), "seconds": seconds,
+                         "primary": score(files, gold["primary"]) if ok else None,
+                         "secondary": score(files, gold["secondary"]) if ok else None}
+    return {"instance_id": instance_id, "alias": alias, "query_chars": len(problem),
+            "query_truncated": truncated, "gold": gold, "configs": configs}
+
+
+def load_locagent() -> dict[str, dict]:
+    """OpenHands/SWE-bench_Pro-locagent rows by id; snapshot written once, read offline afterwards."""
+    if not config.LOCAGENT_SNAPSHOT.exists():
+        from datasets import load_dataset
+
+        rows = [{k: r[k] for k in ("instance_id", "repo", "base_commit", "problem_statement", "patch")}
+                for r in load_dataset(config.LOCAGENT_DATASET, split="test")]
+        config.LOCAGENT_SNAPSHOT.parent.mkdir(parents=True, exist_ok=True)
+        config.LOCAGENT_SNAPSHOT.write_text("".join(json.dumps(r) + "\n" for r in rows))
+    rows = [json.loads(line) for line in config.LOCAGENT_SNAPSHOT.read_text().splitlines() if line]
+    return {r["instance_id"]: r for r in rows}
+
+
+def task_list_path(name: str) -> Path:
+    """tasks/<name>.json, else a temporary list under runs/ (e.g. the subset whose indexes are ready)."""
+    path = config.TASKS_DIR / f"{name}.json"
+    return path if path.exists() else config.RUNS / f"{name}.json"
+
+
+def run(ids: list[str]) -> list[dict]:
+    rows = load_locagent()
+    records = []
+    for iid in ids:
+        r = rows[iid]
+        records.append(localize_task(iid, r["problem_statement"], r["patch"], indexing.alias_for(iid),
+                                     repos.task_dir(iid)))
+    out = config.RUNS / "localize.jsonl"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text("".join(json.dumps(r) + "\n" for r in records))
+    return records
+
+
+# --- report ------------------------------------------------------------------------------------
+
+_METRICS = (("R@1", "recall@1"), ("R@5", "recall@5"), ("R@10", "recall@10"), ("Hit@5", "hit@5"), ("MRR", "mrr"))
+
+
+def _config_names(records: list[dict]) -> list[str]:
+    names: dict[str, None] = {}
+    for r in records:
+        names.update(dict.fromkeys(r["configs"]))
+    return list(names)
+
+
+def _metric_table(records: list[dict], gold: str) -> list[str]:
+    lines = ["| config | n | " + " | ".join(h for h, _ in _METRICS) + " |",
+             "|---|---:|" + "---:|" * len(_METRICS)]
+    for name in _config_names(records):
+        ms = [r["configs"][name][gold] for r in records if name in r["configs"] and r["configs"][name][gold]]
+        cells = [f"{sum(m[k] for m in ms) / len(ms):.2f}" if ms else "–" for _, k in _METRICS]
+        lines.append(f"| {name} | {len(ms)} | " + " | ".join(cells) + " |")
+    return lines
+
+
+def _rank_cell(c: dict | None) -> str:
+    if c is None:
+        return "–"
+    if c["error"]:
+        return "err"
+    if c["primary"] is None:
+        return "n/a"
+    rank = c["primary"]["rank_of_first_gold"]
+    return "–" if rank is None else str(rank)
+
+
+def render(records: list[dict], tasks_name: str, wall_seconds: float | None = None) -> str:
+    names = _config_names(records)
+    md = [f"# Component localization — {tasks_name}", "",
+          "Files ranked for the original issue text (SWE-bench_Pro-locagent `problem_statement`), no LLM. "
+          f"tea-rags configurations search `language: {LANGUAGE}` chunks, with the preset filter cleared or, "
+          f"for `-prod` configurations, set to `production`; `bm25` ranks git-tracked `{'/'.join(EXTS)}` "
+          f"files and `bm25-prod` the same minus test and doc files. A gold file outside the top "
+          f"{TOP_PERSISTED} counts as not found (rank –).", ""]
+    if wall_seconds is not None:
+        md += [f"Wall time: {wall_seconds:.0f} s for {len(records)} tasks.", ""]
+    md += ["## Primary gold (gold `.py` files)", ""] + _metric_table(records, "primary")
+    md += ["", "## Secondary gold (every gold file)", ""] + _metric_table(records, "secondary")
+    md += ["", "## Rank of the first primary gold file per task", "",
+           "| task | gold .py | " + " | ".join(names) + " |", "|---|---:|" + "---:|" * len(names)]
+    for r in records:
+        md.append(f"| {r['instance_id']} | {len(r['gold']['primary'])} | "
+                  + " | ".join(_rank_cell(r["configs"].get(n)) for n in names) + " |")
+    notes = []
+    truncated = [r["instance_id"] for r in records if r["query_truncated"]]
+    if truncated:
+        notes.append(f"Queries truncated: {', '.join(truncated)} (cap {MAX_QUERY_CHARS} chars)")
+    unscored = [r["instance_id"] for r in records if not r["gold"]["primary"]]
+    if unscored:
+        notes.append(f"Unscored (no gold .py file): {', '.join(unscored)}")
+    for r in records:
+        for name, c in r["configs"].items():
+            if c["error"]:
+                notes.append(f"Errored: {r['instance_id']} {name}: {c['error']}")
+            elif c["files"] == 0:
+                notes.append(f"Empty ranking: {r['instance_id']} {name}")
+    if notes:
+        md += ["", "## Notes", ""] + [f"- {n}" for n in notes]
+    return "\n".join(md) + "\n"
diff --git a/evals/swe-bench-lite/src/swe_lite_ab/pro.py b/evals/swe-bench-lite/src/swe_lite_ab/pro.py
new file mode 100644
index 000000000..44eba4fbe
--- /dev/null
+++ b/evals/swe-bench-lite/src/swe_lite_ab/pro.py
@@ -0,0 +1,145 @@
+"""SWE-bench Pro V2 (ScaleAI/SWE-bench_Pro, split test), Python + TypeScript rows, graded locally.
+
+The agent input is each task's `instruction.md` from the tooling checkout (PR description +
+requirements + new interfaces), not the dataset's bare problem_statement. Grading follows the V2
+verifier contract: the task's `tests/` dir mounted at /tests, the model patch applied in /app, then
+the unchanged `bash /tests/test.sh`, whose exit code is the verdict.
+"""
+import json
+import shlex
+import subprocess
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+from . import config
+from .tasks import Task
+
+# Labelled js/ts in the dataset, but their patches are .ts/.tsx. NodeBB (plain JS) and Go are dropped.
+TS_REPOS = frozenset({"protonmail/webclients", "element-hq/element-web", "tutao/tutanota"})
+IMAGE_REPO = "ghcr.io/scaleapi/swe-bench_pro-v2"
+
+
+def language(row: dict) -> str | None:
+    if row["repo_language"] == "python":
+        return "python"
+    return "ts" if row["repo"] in TS_REPOS else None
+
+
+def kind(row: dict) -> str:
+    return "bug" if any(label.endswith("_bug") for label in json.loads(row["issue_specificity"])) else "feature"
+
+
+def task_dir(instance_id: str) -> Path:
+    return config.PRO_OS / "v2" / "tasks" / instance_id
+
+
+def image_name(instance_id: str) -> str:
+    return f"{IMAGE_REPO}:{instance_id}"
+
+
+def to_record(row: dict, instruction: str) -> dict:
+    return {"instance_id": row["instance_id"], "repo": row["repo"], "base_commit": row["base_commit"],
+            "problem_statement": instruction, "patch": row["patch"], "created_at": "", "kind": kind(row),
+            "image": row["docker_image"], "language": language(row), "hard": bool(row["hard"])}
+
+
+def _task(rec: dict) -> Task:
+    return Task(rec["instance_id"], rec["repo"], rec["base_commit"], rec["problem_statement"], rec["patch"],
+                rec["created_at"], kind=rec["kind"])
+
+
+def load_records() -> list[dict]:
+    """Snapshot written once; later stages read it offline, so task content stays fixed."""
+    if not config.PRO_SNAPSHOT.exists():
+        records = [to_record(r, (task_dir(r["instance_id"]) / "instruction.md").read_text())
+                   for r in _fetch_rows() if language(r)]
+        records.sort(key=lambda r: r["instance_id"])
+        config.PRO_SNAPSHOT.parent.mkdir(parents=True, exist_ok=True)
+        config.PRO_SNAPSHOT.write_text("".join(json.dumps(r) + "\n" for r in records))
+    return [json.loads(line) for line in config.PRO_SNAPSHOT.read_text().splitlines() if line]
+
+
+def load() -> list[Task]:
+    return [_task(r) for r in load_records()]
+
+
+def _fetch_rows() -> list[dict]:
+    from datasets import load_dataset
+
+    return list(load_dataset(config.PRO_DATASET, split="test"))
+
+
+# An empty patch skips `git apply` and grades the untouched base (unresolved); a patch that does not
+# apply exits 3 before the verifier runs (unresolved too).
+_GRADE_SCRIPT = """set -u
+cd /app 2>/dev/null || cd /testbed || exit 2
+git config --global --add safe.directory '*'
+if [ -s /model.patch ]; then
+  git apply -v /model.patch || { echo '>>>>> MODEL PATCH DID NOT APPLY'; exit 3; }
+fi
+bash /tests/test.sh
+rc=$?
+echo ">>>>> verifier exit $rc; run_script stdout tail:"
+tail -n 200 /logs/verifier/run-script-stdout.txt 2>/dev/null
+exit $rc
+"""
+
+
+def grade_command(instance_id: str, patch_path: Path) -> list[str]:
+    return ["docker", "run", "--rm", "--platform", "linux/amd64",
+            "-v", f"{task_dir(instance_id) / 'tests'}:/tests:ro",
+            "-v", f"{patch_path}:/model.patch:ro",
+            "--entrypoint", "/bin/bash", image_name(instance_id), "-c", _GRADE_SCRIPT]
+
+
+def ensure_image(image: str) -> None:
+    if subprocess.run(["docker", "image", "inspect", image], capture_output=True).returncode != 0:
+        subprocess.run(["docker", "pull", "-q", "--platform", "linux/amd64", image], check=True)
+
+
+def _verify(argv: list[str], log: Path) -> int:
+    with log.open("w") as out:
+        try:
+            return subprocess.run(argv, stdout=out, stderr=subprocess.STDOUT,
+                                  timeout=config.PRO_VERIFIER_TIMEOUT_S).returncode
+        except subprocess.TimeoutExpired:
+            out.write(f"\n>>>>> verifier timed out after {config.PRO_VERIFIER_TIMEOUT_S} s\n")
+            return 124
+
+
+def _predictions(arm: str) -> dict[str, str]:
+    path = config.RUNS / arm / "predictions.jsonl"
+    if not path.exists():
+        return {}
+    preds = (json.loads(line) for line in path.read_text().splitlines() if line.strip())
+    return {p["instance_id"]: p.get("model_patch") or "" for p in preds}
+
+
+def grade(arm: str, tasks: list[Task], run_id: str, workers: int = 1) -> Path:
+    """Grades runs/<arm>/predictions.jsonl task by task (a missing prediction grades as an empty
+    patch), keeps each verifier log under runs/<arm>/eval/<run_id>/, and writes the report where
+    evaluate.report_path expects it."""
+    from .evaluate import report_path
+
+    out_dir = config.RUNS / arm / "eval" / run_id
+    out_dir.mkdir(parents=True, exist_ok=True)
+    preds = _predictions(arm)
+
+    def one(task: Task) -> tuple[str, int]:
+        patch = preds.get(task.instance_id, "")
+        patch_file = out_dir / f"{task.instance_id}.diff"
+        # git apply rejects a final hunk without its trailing newline as a corrupt patch.
+        patch_file.write_text(patch if not patch or patch.endswith("\n") else patch + "\n")
+        ensure_image(image_name(task.instance_id))
+        return task.instance_id, _verify(grade_command(task.instance_id, patch_file.absolute()),
+                                         out_dir / f"{task.instance_id}.log")
+
+    with ThreadPoolExecutor(workers) as pool:
+        codes = dict(pool.map(one, tasks))
+    report = {"total_instances": len(tasks), "submitted_ids": sorted(preds),
+              "resolved_ids": sorted(i for i, c in codes.items() if c == 0),
+              "unresolved_ids": sorted(i for i, c in codes.items() if c != 0), "exit_codes": codes}
+    path = report_path(arm, run_id)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(report, indent=2) + "\n")
+    return path
diff --git a/evals/swe-bench-lite/src/swe_lite_ab/probe.py b/evals/swe-bench-lite/src/swe_lite_ab/probe.py
new file mode 100644
index 000000000..02c9bbcc4
--- /dev/null
+++ b/evals/swe-bench-lite/src/swe_lite_ab/probe.py
@@ -0,0 +1,123 @@
+"""Memorisation probe: can the model name the files to change from the task text alone?
+
+The model gets only the repository name and the task's problem statement - no checkout, no tools,
+no MCP servers, no instructions from the operator's CLAUDE.md. A task whose gold file it names
+anyway is likely memorised (or trivially implied by the text) and is reported apart.
+"""
+import json
+import os
+import re
+import subprocess
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+from . import config
+from .repos import instruction_leaks
+from .tasks import Task, gold_files, mentions_gold_file
+
+PROBE_PROMPT = """The following task is for the GitHub repository {repo}. You do not have access to the
+repository; answer from what you know about it.
+
+<task>
+{problem_statement}
+</task>
+
+List the repository-relative paths of the source files that must change to implement this task,
+one per line, most likely first. Output only the paths: no prose, no bullets, no code fences.
+"""
+
+_LIST_MARKER = re.compile(r"^(?:[-*+•]\s+|\d+[.)]\s+)")
+_PATH = re.compile(r"^[\w.@~+-]+(?:/[\w.@~+-]+)*\.\w+$|^[\w.@~+-]+(?:/[\w.@~+-]+)+$")
+
+
+def render_prompt(task: Task) -> str:
+    return PROBE_PROMPT.format(repo=task.repo, problem_statement=task.problem_statement)
+
+
+def parse_paths(answer: str) -> list[str]:
+    """Path-shaped lines of the answer, list markers / backticks / ./ and a/ prefixes removed, deduplicated."""
+    out: list[str] = []
+    for line in answer.splitlines():
+        p = _LIST_MARKER.sub("", line.strip()).strip().strip("`").strip()
+        for prefix in ("./", "a/", "b/"):
+            if p.startswith(prefix):
+                p = p[len(prefix):]
+        if _PATH.match(p) and p not in out:
+            out.append(p)
+    return out
+
+
+def hit(predicted: list[str], task: Task) -> bool:
+    return bool(set(predicted) & set(gold_files(task.patch)))
+
+
+def run_dir(instance_id: str) -> Path:
+    return config.RUNS / "probe" / instance_id
+
+
+def build_command(task: Task, rdir: Path) -> tuple[list[str], dict[str, str]]:
+    """Same isolation as agent.build_command, with every tool disabled (`--tools ""`)."""
+    (rdir / "config").mkdir(parents=True, exist_ok=True)
+    mcp_path = rdir / "mcp.json"
+    mcp_path.write_text(json.dumps({"mcpServers": {}}))
+    argv = ["claude", "-p", render_prompt(task),
+            "--model", config.MODEL,
+            "--output-format", "json",
+            "--tools", "",
+            "--no-session-persistence",
+            "--strict-mcp-config", "--mcp-config", str(mcp_path)]
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("CLAUDE", "ANTHROPIC"))}
+    env["CLAUDE_CONFIG_DIR"] = str(rdir / "config")
+    if config.TOKEN_FILE.exists():
+        env["CLAUDE_CODE_OAUTH_TOKEN"] = config.TOKEN_FILE.read_text().strip()
+    return argv, env
+
+
+def ask(task: Task) -> dict:
+    """The CLI's --output-format json result object."""
+    cwd = config.PROBE_ROOT / task.instance_id
+    cwd.mkdir(parents=True, exist_ok=True)
+    leaks = instruction_leaks(cwd)
+    if leaks or any(cwd.iterdir()):
+        raise RuntimeError(f"probe cwd {cwd} is not an isolated empty dir: {', '.join(map(str, leaks))}")
+    rdir = run_dir(task.instance_id)
+    argv, env = build_command(task, rdir)
+    proc = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, timeout=600)
+    if proc.returncode != 0:
+        raise RuntimeError(f"probe {task.instance_id}: claude exited {proc.returncode}: {proc.stderr[-2000:]}")
+    (rdir / "result.json").write_text(proc.stdout)  # raw answer + usage, for auditing the parse
+    return json.loads(proc.stdout)
+
+
+def record(task: Task, result: dict) -> dict:
+    predicted = parse_paths(result.get("result") or "")
+    return {"instance_id": task.instance_id, "predicted": predicted, "hit": hit(predicted, task),
+            "named": mentions_gold_file(task), "cost_usd": result.get("total_cost_usd")}
+
+
+def load_records(path: Path) -> list[dict]:
+    if not path.exists():
+        return []
+    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
+
+
+def load_hits(path: Path) -> dict[str, bool]:
+    return {r["instance_id"]: r["hit"] for r in load_records(path)}
+
+
+def run(tasks: list[Task], parallel: int = 2) -> Path:
+    """Appends one record per task to config.PROBE_FILE; tasks already recorded are skipped (resumable)."""
+    out = config.PROBE_FILE
+    done = set(load_hits(out))
+    lock = threading.Lock()
+    out.parent.mkdir(parents=True, exist_ok=True)
+
+    def one(task: Task) -> None:
+        rec = record(task, ask(task))
+        with lock, out.open("a") as f:
+            f.write(json.dumps(rec) + "\n")
+
+    with ThreadPoolExecutor(parallel) as pool:
+        list(pool.map(one, [t for t in tasks if t.instance_id not in done]))
+    return out
diff --git a/evals/swe-bench-lite/src/swe_lite_ab/rebench.py b/evals/swe-bench-lite/src/swe_lite_ab/rebench.py
new file mode 100644
index 000000000..f5c533fd0
--- /dev/null
+++ b/evals/swe-bench-lite/src/swe_lite_ab/rebench.py
@@ -0,0 +1,69 @@
+"""SWE-rebench leaderboard rows as swebench 5.x harness instances.
+
+swebench 5.x grades from per-instance `image` / `eval_script` / `log_parser` / `eval_type`; rebench
+ships `docker_image` and an `install_config` with the test command instead. The rebench images keep
+conda under /opt/conda (Lite's under /opt/miniconda3) with the repository at /testbed.
+"""
+import json
+
+from . import config
+from .tasks import Task, gold_files
