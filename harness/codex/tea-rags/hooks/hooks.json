{
  "description": "TeaRAGs context, code navigation and read tracking",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 10,
            "statusMessage": "TeaRAGs: load core rules"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/session-codex-rules.sh",
            "timeout": 10,
            "statusMessage": "TeaRAGs: load Codex context policy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/session-digest.sh",
            "timeout": 60,
            "statusMessage": "TeaRAGs: load project digest"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness codex",
            "timeout": 10,
            "statusMessage": "TeaRAGs: initialize read ledger"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/subagent-block.sh",
            "timeout": 30,
            "statusMessage": "TeaRAGs: load subagent context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/turn-routing.sh --harness codex",
            "timeout": 5,
            "statusMessage": "TeaRAGs: route this request"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/search-drift.sh --harness codex",
            "timeout": 5,
            "statusMessage": "TeaRAGs: reset search tracking"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness codex",
            "timeout": 5,
            "statusMessage": "TeaRAGs: advance read ledger"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|shell|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/one-file-read.sh",
            "timeout": 10,
            "statusMessage": "TeaRAGs: check document read size"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/search-drift.sh --harness codex",
            "timeout": 10,
            "statusMessage": "TeaRAGs: check search scope"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness codex",
            "timeout": 10,
            "statusMessage": "TeaRAGs: check reused code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*tea[-_]rags.*__",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/search-drift.sh --harness codex",
            "timeout": 5,
            "statusMessage": "TeaRAGs: record search results"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness codex",
            "timeout": 10,
            "statusMessage": "TeaRAGs: remember delivered MCP code"
          }
        ]
      },
      {
        "matcher": "^(Bash|shell|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness codex",
            "timeout": 10,
            "statusMessage": "TeaRAGs: remember delivered shell code"
          }
        ]
      }
    ]
  }
}
