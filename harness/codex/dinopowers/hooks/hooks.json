{
  "description": "Dinopowers workflow routing for sessions and subagents",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/main-session-routing.sh",
            "timeout": 10,
            "statusMessage": "Dinopowers: load workflow routing"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/wrapper-routing.sh",
            "timeout": 10,
            "statusMessage": "Dinopowers: load subagent workflow routing"
          }
        ]
      }
    ]
  }
}
