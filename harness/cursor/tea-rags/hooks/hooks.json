{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/session-start.sh\"",
        "timeout": 60
      }
    ],
    "subagentStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/subagent-start.sh\"",
        "timeout": 30
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/after-shell-execution.sh\"",
        "timeout": 120
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/turn-routing.sh\" --harness cursor",
        "timeout": 5
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/search-drift.sh\" --harness cursor",
        "timeout": 5
      },
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness cursor",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/turn-routing.sh\" --harness cursor",
        "timeout": 5
      },
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness cursor",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell|Grep",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/search-drift.sh\" --harness cursor",
        "timeout": 10
      },
      {
        "matcher": "Shell|Read",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness cursor",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/search-drift.sh\" --harness cursor",
        "timeout": 5
      },
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/reread-ledger.mjs\" --harness cursor",
        "timeout": 10
      }
    ]
  }
}
