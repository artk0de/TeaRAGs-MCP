#!/bin/bash

# Run beads sync if available (optional - contributors may not have bd)
if command -v bd >/dev/null 2>&1; then
  bd hooks run pre-commit "$@" 2>/dev/null || true
fi

# Format and lint staged .ts/.js files
if ! npx lint-staged 2>&1; then
  echo ""
  echo "============================================"
  echo "  lint-staged failed (ESLint or Prettier)"
  echo "============================================"
  echo ""
  echo "If ESLint --fix could not auto-fix the issue:"
  echo "  1. Read the error message above"
  echo "  2. Fix the code manually (do NOT change eslint.config.js)"
  echo "  3. Stage the fix: git add <file>"
  echo "  4. Retry the commit"
  echo ""
  echo "Common fixes:"
  echo "  - no-floating-promises  → add 'await' or 'void' before the promise"
  echo "  - no-unused-vars        → remove the unused variable/import"
  echo "  - eqeqeq                → use === instead of =="
  echo "  - consistent-type-imports → add 'type' keyword to type-only imports"
  echo ""
  exit 1
fi

# ─── Raw NUL bytes in staged text files (bd tea-rags-mcp-k8gac) ───────────────
# Every commit, after lint-staged has rewritten what it formats: reads the staged
# blobs, not the working tree. Not left to the test run below — `vitest related`
# selects tests by import, and tests/source-nul-bytes.test.ts imports nothing a
# commit stages, so it ran only when it was itself staged.
if ! npx tsx scripts/check-staged-nul-bytes.ts; then
  echo ""
  echo "❌ Raw NUL byte(s) in staged files — replace each with an escape, re-stage, retry."
  exit 1
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# ─── Plugin versioning check ───────────────────────────────────────────────
# If .claude-plugin/ files changed, plugin.json must be bumped too.
# Skip on merge commits: the version bump must live in the merged branch
# (each branch is self-contained), not as a separate commit on the merge target.
GIT_DIR_FOR_MERGE_CHECK=$(git rev-parse --git-dir)
if [ -f "$GIT_DIR_FOR_MERGE_CHECK/MERGE_HEAD" ]; then
  echo "⏭️  Merge commit — skipping plugin version check (bump must be in the merged branch)"
else
  # Every plugin, derived from the manifests on disk rather than a hard-coded
  # list: a directory under .claude-plugin/ is a plugin iff it carries one, which
  # both picks up dinopowers (a hard-coded pair left it unenforced) and keeps
  # .claude-plugin/.benchmarks/ out of it. Same rule as .claude/hooks/check-plugin-version.sh.
  for plugin_json in .claude-plugin/*/.claude-plugin/plugin.json; do
    [ -f "$plugin_json" ] || continue
    plugin_dir=$(dirname "$(dirname "$plugin_json")")
    plugin_name=$(basename "$plugin_dir")
    # Check if any files in this plugin are staged (excluding plugin.json itself)
    plugin_files=$(echo "$STAGED_FILES" | grep "^${plugin_dir}/" | grep -v ".claude-plugin/plugin.json" || true)
    if [ -n "$plugin_files" ]; then
      # Check if plugin.json is also staged
      json_staged=$(echo "$STAGED_FILES" | grep "^${plugin_json}$" || true)
      if [ -z "$json_staged" ]; then
        echo ""
        echo "============================================"
        echo "  Plugin version bump required: $plugin_name"
        echo "============================================"
        echo ""
        echo "Files changed in $plugin_dir/ but $plugin_json was not updated."
        echo "Bump the version (patch for text changes, minor for new files),"
        echo "then stage it: git add $plugin_json"
        echo ""
        echo "If commit is a worktree-side bump (you're on a feature branch),"
        echo "bump and commit it here — the merge into main will skip this check."
        echo ""
        exit 1
      fi
    fi
  done
fi

# Check if src/ files changed
SRC_CHANGED=$(echo "$STAGED_FILES" | grep -E "^src/" || true)

# Check if TypeScript/JavaScript files changed
TS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(ts|tsx|js|jsx)$" || true)

# Determine what needs to run
RUN_TESTS=""
RUN_TYPECHECK=""

if [ -n "$SRC_CHANGED" ]; then
  RUN_TESTS=1
else
  echo "⏭️  No src/ changes, skipping tests"
fi

if [ -n "$TS_FILES" ]; then
  RUN_TYPECHECK=1
else
  echo "⏭️  No TypeScript changes, skipping type check"
fi

# Run type-check first (fast), then tests — sequential to avoid vitest fork timeouts
if [ -n "$RUN_TYPECHECK" ]; then
  echo "🔍 Running type check..."
  npm run type-check || { echo "❌ Type check failed"; exit 1; }
  # scripts/ sit outside tsconfig.json's src/ root, so `type-check` never sees
  # them — a src/ rename broke a script import unnoticed (xuywm). Gated on any
  # staged TS file, not only scripts/**: a src/ change is what breaks a script.
  echo "🔍 Running scripts type check..."
  npm run type-check:scripts || { echo "❌ Scripts type check failed"; exit 1; }
fi

if [ -n "$RUN_TESTS" ]; then
  echo "📦 Running affected tests (fast, no coverage — full suite + coverage run on CI)..."
  # Pre-commit runs ONLY the tests affected by the staged changes WITHOUT
  # coverage — a full --coverage run takes ~20min and blocks commits. The full
  # suite AND the 90% coverage thresholds are enforced on CI (ci.yml).
  # `vitest related <staged files>`, not `--changed`: `--changed` also takes
  # the UNTRACKED and unstaged files of the working tree, so a test file not
  # part of the commit — a parked red test, another session's work in progress —
  # failed it. Over the staged list, `related` selects exactly what `--changed`
  # did: the staged test files, every test whose imports reach a staged file,
  # and the whole suite when a staged file is a force-rerun trigger
  # (package.json, the vitest config). The list is the one `--changed` read
  # itself — `git diff --cached --name-only`, deletions included.
  # File-backed capture is robust across shells and shell modes (husky's
  # `sh -e` wrapper + lint-staged context breaks $(...) capture unreliably).
  TEST_LOG=$(mktemp -t tea-rags-pre-commit.XXXXXX)
  TESTED_FILES=$(git diff --cached --name-only)
  # `|| TEST_EXIT=$?`: husky runs this hook under `sh -e`, which exits on the
  # failing command itself — before the summary below could say what failed.
  TEST_EXIT=0
  # shellcheck disable=SC2086 # word splitting IS the argument list
  npm test -- related --run --reporter=dot $TESTED_FILES >"$TEST_LOG" 2>&1 || TEST_EXIT=$?
  if [ $TEST_EXIT -ne 0 ]; then
    grep -E "FAIL|×|Error|failed" "$TEST_LOG" | head -20
    echo ""
    echo "❌ Tests failed. Run 'npx vitest run' for details."
    echo "   Full log: $TEST_LOG"
    exit 1
  else
    tail -3 "$TEST_LOG"
    rm -f "$TEST_LOG"
  fi
fi

# Integration tests (tests/**/__integration__/**) are excluded from vitest.config
# and require real external services. Run them manually, not in pre-commit.
